---
import VanillaDemo from './demos/VanillaDemo.astro'
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[640px] bg-grid-fade"></div>
  <div class="pointer-events-none absolute -left-24 top-10 -z-10 h-72 w-72 rounded-full bg-blob-a blur-3xl animate-drift"></div>
  <div class="pointer-events-none absolute -right-24 top-40 -z-10 h-72 w-72 rounded-full bg-blob-b blur-3xl animate-drift-slow"></div>

  <div class="mx-auto flex max-w-5xl flex-col items-center px-6 pb-20 pt-20 text-center sm:pt-28">
    <a
      href="https://github.com/boastack/verino"
      target="_blank"
      rel="noreferrer"
      data-reveal
      class="mb-7 inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white px-4 py-1.5 text-xs font-medium text-ink-600 shadow-card transition hover:border-ink-300 hover:text-ink-900"
    >
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand opacity-75"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-brand"></span>
      </span>
      One core, seven frameworks, zero dependencies
    </a>

    <h1 data-reveal class="max-w-2xl text-4xl font-bold leading-[1.15] tracking-tight text-ink-950 sm:text-5xl">
      Stop <em class="font-serif text-[1.15em] italic text-brand-dim">wasting</em> time building OTP inputs,
      start using <em class="font-serif text-[1.15em] italic text-brand-dim">Verino</em> engine
    </h1>

    <p data-reveal class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600">
      One invisible input captures SMS autofill, password managers, and paste.
      One pure state machine drives React, Vue, Svelte, Alpine.js, Vanilla JS,
      Web Components, and React Native.
    </p>

    <div data-reveal class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a
        href="#frameworks"
        class="group inline-flex items-center gap-1.5 rounded-full bg-ink-900 px-5 py-2.5 text-sm font-semibold text-white shadow-button transition hover:bg-ink-800 active:scale-[0.97]"
      >
        Try it live
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="transition group-hover:translate-x-0.5">
          <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a
        href="https://github.com/boastack/verino"
        target="_blank"
        rel="noreferrer"
        class="rounded-full border border-ink-200 bg-white px-5 py-2.5 text-sm font-semibold text-ink-900 shadow-xs transition hover:border-ink-300 hover:bg-ink-50 active:scale-[0.97]"
      >
        View on GitHub
      </a>
    </div>

    <div data-reveal class="relative mt-16 w-full max-w-md overflow-hidden rounded-3xl border border-ink-100 bg-white p-6 shadow-card-hover sm:p-10">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-transparent via-brand to-transparent opacity-60"></div>
      <div class="mb-6 flex items-center justify-center gap-1.5 text-xs font-medium text-ink-400">
        <span class="h-1.5 w-1.5 rounded-full bg-brand"></span>
        Live demo
      </div>
      <VanillaDemo id="verino-hero-demo" />
    </div>
    <p data-reveal class="mt-4 text-xs text-ink-400">
      Powered by <code class="rounded bg-ink-50 px-1.5 py-0.5 text-ink-600">@verino/vanilla</code>, zero runtime dependencies
    </p>
  </div>
</section>
