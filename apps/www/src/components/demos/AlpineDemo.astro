<div class="flex flex-col items-center gap-5">
  <div
    class="verino-wrapper"
    id="verino-alpine-demo"
    x-data
    x-verino="{ length: 6, autoFocus: false, onComplete() { document.getElementById('verino-alpine-hint').classList.add('hidden'); document.getElementById('verino-alpine-reset').classList.remove('hidden') } }"
  ></div>
  <p class="text-sm text-ink-500" id="verino-alpine-hint">Type any 6 digits</p>
  <button
    type="button"
    class="hidden rounded-full bg-brand-50 px-4 py-1.5 text-sm font-medium text-brand-dim transition hover:bg-brand-100 active:scale-95"
    id="verino-alpine-reset"
    onclick="document.getElementById('verino-alpine-demo')._verino.reset(); document.getElementById('verino-alpine-reset').classList.add('hidden'); document.getElementById('verino-alpine-hint').classList.remove('hidden')"
  >
    Verified. Reset demo
  </button>
</div>

<script>
  import Alpine from 'alpinejs'
  import { VerinoAlpine } from '@verino/alpine'

  if (!window.Alpine) {
    Alpine.plugin(VerinoAlpine)
    window.Alpine = Alpine
    Alpine.start()
  }
</script>
